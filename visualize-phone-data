  maxZoom: 19,
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
}).addTo(map);

const rawPoints = L.layerGroup();
const filteredPoints = L.layerGroup();
const rawZones = L.layerGroup();
const filteredZones = L.layerGroup();

const bounds = [];

function deviceInfoHtml(d, p) {
  const total = d.points.length;
  const inZone = d.points.filter(q => q.in_zone).length;
  let h = '';
  if (d.label && d.label !== '(unnamed)') h += escapeHtml(d.label) + '<br>';
  if (d.manuf) h += '<i>' + escapeHtml(d.manuf) + '</i><br>';
  if (d.ibeacon) {
    h += '<span style="color:#777;font-size:11px">iBeacon UUID ' + escapeHtml(d.ibeacon.uuid)
       + '<br>major ' + d.ibeacon.major + ' · minor ' + d.ibeacon.minor + '</span><br>';
  }
  h += p.count + ' detection' + (p.count === 1 ? '' : 's') + ' at this point';
  if (p.best_rssi !== null && p.best_rssi !== undefined) h += '<br>best RSSI: ' + p.best_rssi + ' dBm';
  h += '<hr style="border:0;border-top:1px solid #ddd;margin:5px 0">';
  h += '<b>' + total + '</b> GPS coordinate' + (total === 1 ? '' : 's') + ' for this device';
  if (inZone > 0) {
    h += '<br><span style="color:#c0392b">' + inZone + ' inside an exclusion zone &rarr; excluded</span>';
  } else {
    h += '<br><span style="color:#157f3b">none inside a zone</span>';
  }
  h += '<br><span style="color:#777;font-size:11px">highlighted on map — orange ring = this device, '
     + 'red ring = coordinate in a zone</span>';
  h += '<hr style="border:0;border-top:1px solid #ddd;margin:5px 0">';
  h += renderAdv(d);
  h += '<hr style="border:0;border-top:1px solid #ddd;margin:5px 0">';
  h += renderGatt(d);
  return h;
}

// Advertisement (EIR/AD) records — parsed like the phone / Tell_Me_Everything.py (in Python).
function renderAdv(d) {
  if (!d.adv || !d.adv.length) return '<div class="nogatt">No advertisement data.</div>';
  let h = '<details class="gatt"><summary>Advertisement — ' + d.adv.length + ' record'
        + (d.adv.length === 1 ? '' : 's') + '</summary>';
  d.adv.forEach(r => {
    h += '<div class="advrec"><div class="advname">' + escapeHtml(r.name) + '</div>';
    if (r.bits) {
      h += '<div class="props">' + escapeHtml(r.hex || '')
         + (r.bits.length ? ' — ' + r.bits.map(escapeHtml).join(', ') : '') + '</div>';
    }
    if (r.text) h += '<div class="val">' + escapeHtml(r.text) + '</div>';
    (r.uuids || []).forEach(u => { h += '<div class="advuuid">' + uuidTitle(u) + '</div>'; });
    (r.rows || []).forEach(kv => {
      h += '<div class="advkv"><span class="advk">' + escapeHtml(kv[0]) + ':</span> '
         + escapeHtml(kv[1]) + '</div>';
    });
    if (r.hex && !('bits' in r)) h += '<div class="hex">' + escapeHtml(r.hex) + '</div>';
    h += '</div>';
  });
  h += '</details>';
  return h;
}

// GATT/SDP hierarchy — UUID names come from the app's SIG tables + CLUES (resolved in Python).
function uuidTitle(x) {
  return '<b>' + escapeHtml(x.uuid) + '</b> — '
    + (x.name ? escapeHtml(x.name) : '<span class="untag">Unknown</span>');
}
function descLine(de) {
  const t = (de.type || ('Descriptor ' + de.uuid)).replace(/^Characteristic Descriptor:\s*/, '');
  let s = '↳ ' + escapeHtml(de.uuid) + ' — ' + escapeHtml(t);
  if (de.user_desc) s += ': ' + escapeHtml(de.user_desc);
  return '<div class="desc">' + s + '</div>';
}
function renderGatt(d) {
  if (!d.gatt || !d.gatt.length) {
    return '<div class="nogatt">No GATT or SDP data captured for this device.</div>';
  }
  const enumerated = d.gatt.some(s => !s.advertised);
  let h = '<details class="gatt"><summary>GATT — ' + d.gatt.length + ' service'
        + (d.gatt.length === 1 ? '' : 's') + (enumerated ? '' : ' (advertised only)') + '</summary>';
  d.gatt.forEach(s => {
    h += '<details class="svc"><summary>' + uuidTitle(s)
       + (s.advertised ? ' <span class="advtag">advertised</span>' : '') + '</summary>';
    if (s.company) h += '<div class="company">' + escapeHtml(s.company) + '</div>';
    if (!s.chars || !s.chars.length) {
      h += '<div class="muted">' + (s.advertised ? 'not enumerated' : 'no characteristics') + '</div>';
    } else {
      s.chars.forEach(c => {
        h += '<div class="char"><div class="charhead">' + uuidTitle(c) + '</div>';
        if (c.company) h += '<div class="company">' + escapeHtml(c.company) + '</div>';
        if (c.props && c.props.length) h += '<div class="props">' + c.props.join(' · ') + '</div>';
        if (c.value) h += '<div class="val">value: ' + escapeHtml(c.value) + '</div>';
        if (c.hex) h += '<div class="hex">' + escapeHtml(c.hex) + '</div>';
        (c.descriptors || []).forEach(de => { h += descLine(de); });
        h += '</div>';
      });
    }
    h += '</details>';
  });
  h += '</details>';
  return h;
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
}

// --- highlight: a clicked device's full set of coordinates ------------------
// Drawn non-interactively on top so it never steals clicks from the points
// underneath. Red ring = that coordinate is inside an exclusion zone.
const highlightLayer = L.layerGroup().addTo(map);
let markerClicked = false;
let hideApple = false, hideSamsung = false, hasGattOnly = false, currentView = 'raw';

function highlightDevice(d, hub, fit = true) {
  highlightLayer.clearLayers();
  d.points.forEach(p => {
    if (hub && (p.lat !== hub[0] || p.lng !== hub[1])) {
      highlightLayer.addLayer(L.polyline([hub, [p.lat, p.lng]], {
        color: '#f39c12', weight: 1.5, opacity: 0.7, dashArray: '4 4', interactive: false
      }));
    }
    highlightLayer.addLayer(L.circleMarker([p.lat, p.lng], {
      radius: 8, weight: 3, fill: false, interactive: false,
      color: p.in_zone ? '#c0392b' : '#f39c12'
    }));
  });
  highlightLayer.eachLayer(l => l.bringToFront && l.bringToFront());
  // Only pan/zoom-out if some of this device's coordinates are off-screen, so a
  // device you can already see fully doesn't make the map jump.
  const b = L.latLngBounds(d.points.map(p => [p.lat, p.lng]));
  if (fit && !map.getBounds().contains(b)) map.fitBounds(b, { padding: [60, 60], maxZoom: map.getZoom() });
}

// Click empty map to clear; the guard stops a point-click from also clearing.
map.on('click', () => { if (!markerClicked) { highlightLayer.clearLayers(); hidePanel(); } });

// --- draggable info panel (replaces the anchored popup so it can be dragged off points) ---
const panel = document.getElementById('infopanel');

function showPanel(title, html) {
  document.getElementById('infopanel-title').textContent = title;
  document.getElementById('infopanel-body').innerHTML = html;
  if (!panel.dataset.moved) {  // default spot until the user drags it; then keep their spot
    panel.style.top = (document.getElementById('header').offsetHeight + 12) + 'px';
    panel.style.left = 'auto';
    panel.style.right = '16px';
  }
  panel.style.display = 'flex';
}
function hidePanel() { panel.style.display = 'none'; }

(function makePanelDraggable() {
  const bar = document.getElementById('infopanel-bar');
  let drag = null;
  bar.addEventListener('mousedown', e => {
    if (e.target.id === 'infopanel-close') return;
    panel.dataset.moved = '1';
    drag = { x: e.clientX, y: e.clientY, left: panel.offsetLeft, top: panel.offsetTop };
    panel.style.right = 'auto';  // switch from right-anchored to free left/top
    panel.style.left = panel.offsetLeft + 'px';
    panel.style.top = panel.offsetTop + 'px';
    e.preventDefault();
  });
  document.addEventListener('mousemove', e => {
    if (!drag) return;
    const app = document.getElementById('app').getBoundingClientRect();
    const nl = Math.max(0, Math.min(drag.left + e.clientX - drag.x, app.width - panel.offsetWidth));
    const nt = Math.max(0, Math.min(drag.top + e.clientY - drag.y, app.height - panel.offsetHeight));
    panel.style.left = nl + 'px';
    panel.style.top = nt + 'px';
  });
  document.addEventListener('mouseup', () => { drag = null; });
})();

// --- stacked-point selection -------------------------------------------------
// Many devices share the same coordinate, so a click can land on a pile of
// markers. Gather every *visible* device whose point sits within a few pixels of
// the click; if there's more than one, let the user pick from a list.
const STACK_RADIUS_PX = 8;
let currentStack = [];

function pointsNear(lat, lng) {
  const a = map.latLngToContainerPoint([lat, lng]);
  const byDevice = new Map();
  DATA.devices.forEach(d => {
    if (deviceHidden(d)) return;                          // honor Hide Apple/Samsung
    if (currentView === 'filtered' && d.excluded) return; // honor the GPS-exclusion tab
    d.points.forEach(p => {
      const cp = map.latLngToContainerPoint([p.lat, p.lng]);
      const dist = Math.hypot(cp.x - a.x, cp.y - a.y);
      if (dist <= STACK_RADIUS_PX) {
        const prev = byDevice.get(d.address);
        if (!prev || dist < prev.dist) byDevice.set(d.address, { d, p, dist });
      }
    });
  });
  return [...byDevice.values()].sort((x, y) => x.dist - y.dist);
}

function openSelection(stack) {
  if (!stack.length) return;
  currentStack = stack;
  if (stack.length === 1) showDeviceDetail(0);
  else showChooser();
}

function showChooser() {
  const rows = currentStack.map((it, i) => {
    const d = it.d;
    const dot = d.excluded ? '#e74c3c' : '#41b6c4';
    const sub = [d.label !== '(unnamed)' ? escapeHtml(d.label) : '', d.manuf ? escapeHtml(d.manuf) : '']
      .filter(Boolean).join(' · ');
    const ven = d.vendor ? ' <span class="ventag">' + d.vendor + '</span>' : '';
    return '<div class="choice" onclick="selectFromStack(' + i + ')" '
      + 'onmouseover="previewFromStack(' + i + ')">'
      + '<span class="cdot" style="background:' + dot + '"></span>'
      + '<span class="cmain"><b>' + d.address + '</b>' + ven
      + (sub ? '<br><span class="csub">' + sub + '</span>' : '') + '</span></div>';
  }).join('');
  showPanel(currentStack.length + ' devices at this point',
    '<div class="chooser">' + rows + '</div>'
    + '<div class="choosehint">click one for details &amp; map highlight (hover to preview)</div>');
}

function previewFromStack(i) {
  const it = currentStack[i];
  if (it) highlightDevice(it.d, [it.p.lat, it.p.lng], false);  // no pan on hover
}

function selectFromStack(i) { showDeviceDetail(i); }

function showDeviceDetail(i) {
  const it = currentStack[i];
  if (!it) return;
  let html = '';
  if (currentStack.length > 1) {
    html += '<span class="backlink" onclick="showChooser()">&lsaquo; back to '
      + currentStack.length + ' devices here</span>'
      + '<hr style="border:0;border-top:1px solid #ddd;margin:5px 0">';
  }
  html += deviceInfoHtml(it.d, it.p);
  showPanel(it.d.address, html);
  highlightDevice(it.d, [it.p.lat, it.p.lng]);
}

// --- points -----------------------------------------------------------------
function addPoint(group, d, p, color, fillColor) {
  const mk = L.circleMarker([p.lat, p.lng], {
    radius: 4, weight: 1, color, fillColor, fillOpacity: 0.75
  });
  mk.on('click', () => {
    markerClicked = true;
    setTimeout(() => { markerClicked = false; }, 0);
    openSelection(pointsNear(p.lat, p.lng));
  });
  group.addLayer(mk);
}

// One-time map framing over ALL points (vendor toggles don't change the frame).
DATA.devices.forEach(d => d.points.forEach(p => bounds.push([p.lat, p.lng])));

// "Hide Apple"/"Hide Samsung" — same vendor classification as the phone.
function deviceHidden(d) {
  return (hideApple && d.vendor === 'apple')
      || (hideSamsung && d.vendor === 'samsung')
      || (hasGattOnly && !d.has_gatt);
}

// (Re)build both point layers honoring the current Hide Apple / Hide Samsung toggles.
function buildPoints() {
  rawPoints.clearLayers();
  filteredPoints.clearLayers();
  DATA.devices.forEach(d => {
    if (deviceHidden(d)) return;
    d.points.forEach(p => {
      // Raw view: blue = will be kept, red = belongs to a device that will be excluded.
      addPoint(rawPoints, d, p, d.excluded ? '#c0392b' : '#2c7fb8', d.excluded ? '#e74c3c' : '#41b6c4');
      if (!d.excluded) addPoint(filteredPoints, d, p, '#2c7fb8', '#41b6c4');
    });
  });
}

function onVendorToggle() {
  hideApple = document.getElementById('hide-apple').checked;
  hideSamsung = document.getElementById('hide-samsung').checked;
  hasGattOnly = document.getElementById('has-gatt').checked;
  highlightLayer.clearLayers();
  hidePanel();
  buildPoints();
  updateInfo(currentView);
}

// --- exclusion zones --------------------------------------------------------
function drawZones(group, dashed) {
  DATA.zones.forEach(z => {
    const style = { color: '#111', weight: 2.5, fill: false,
                    dashArray: dashed ? '6 6' : null };
    let layer;
    if (z.type === 'circle') {
      layer = L.circle([z.centerLat, z.centerLng],
                       Object.assign({ radius: z.radiusMeters }, style));
    } else { // square — same meters->deg conversion as the app's hit-test
      const dLat = z.halfSizeMeters / 111320.0;
      const cosLat = Math.max(Math.cos(z.centerLat * Math.PI / 180), 1e-6);
      const dLng = z.halfSizeMeters / (111320.0 * cosLat);
      layer = L.rectangle([[z.centerLat - dLat, z.centerLng - dLng],
                           [z.centerLat + dLat, z.centerLng + dLng]], style);
      bounds.push([z.centerLat - dLat, z.centerLng - dLng]);
      bounds.push([z.centerLat + dLat, z.centerLng + dLng]);
    }
    layer.on('click', () => {
      markerClicked = true;
      setTimeout(() => { markerClicked = false; }, 0);
      highlightLayer.clearLayers();
      const dims = z.type === 'circle'
        ? 'Circle &middot; radius ' + Math.round(z.radiusMeters) + ' m'
        : 'Square &middot; ' + Math.round(z.halfSizeMeters * 2) + ' m per side';
      showPanel('Exclusion zone', dims
        + '<br><span style="color:#777;font-size:11px">center '
        + z.centerLat.toFixed(5) + ', ' + z.centerLng.toFixed(5) + '</span>');
    });
    group.addLayer(layer);
  });
  // include circle extents in bounds
  DATA.zones.filter(z => z.type === 'circle').forEach(z => {
    const dLat = z.radiusMeters / 111320.0;
    const cosLat = Math.max(Math.cos(z.centerLat * Math.PI / 180), 1e-6);
    const dLng = z.radiusMeters / (111320.0 * cosLat);
    bounds.push([z.centerLat - dLat, z.centerLng - dLng]);
    bounds.push([z.centerLat + dLat, z.centerLng + dLng]);
  });
}
drawZones(rawZones, true);
drawZones(filteredZones, false);

if (bounds.length) map.fitBounds(bounds, { padding: [40, 40] });
else map.setView([0, 0], 2);

// --- view switching ---------------------------------------------------------
const m = DATA.meta;
function updateInfo(view) {
  const visible = DATA.devices.filter(d => !deviceHidden(d));
  const pts = visible.reduce((sum, d) => sum + d.points.length, 0);
  const hidden = [];
  if (hideApple) hidden.push('Apple');
  if (hideSamsung) hidden.push('Samsung');
  let hideNote = hidden.length
    ? ' · <span style="color:#f6c177">hiding ' + hidden.join(' + ') + '</span>' : '';
  if (hasGattOnly) hideNote += ' · <span style="color:#f6c177">GATT only</span>';
  let s;
  if (view === 'raw') {
    s = '<b>' + visible.length + '</b> devices with GPS coordinates · <b>' + pts + '</b> points · '
      + '<b>' + m.zones + '</b> exclusion zone' + (m.zones === 1 ? '' : 's')
      + ' (dotted)'
      + '<span class="swatch" style="background:#41b6c4"></span>kept'
      + '<span class="swatch" style="background:#e74c3c"></span>in/under a zone → will be excluded'
      + hideNote
      + '<span class="hint">— click a point to highlight all of that device’s coordinates</span>';
  } else {
    const kept = visible.filter(d => !d.excluded).length;
    const excl = visible.filter(d => d.excluded).length;
    s = '<b>' + kept + '</b> of <b>' + visible.length
      + '</b> devices with GPS coordinates shown · '
      + '<b>' + excl + '</b> excluded (any coordinate inside a zone) · '
      + 'zones drawn solid' + hideNote;
  }
  document.getElementById('info').innerHTML = s;
}

function showView(view) {
  currentView = view;
  const raw = view === 'raw';
  document.getElementById('tab-raw').classList.toggle('active', raw);
  document.getElementById('tab-filtered').classList.toggle('active', !raw);
  highlightLayer.clearLayers();
  hidePanel();
  [rawPoints, rawZones, filteredPoints, filteredZones].forEach(l => map.removeLayer(l));
  // Zones first, points last → points sit on top of the (no-fill) zones on the
  // shared canvas, so a point inside a zone is still the one that gets clicked.
  if (raw) { rawZones.addTo(map); rawPoints.addTo(map); }
  else { filteredZones.addTo(map); filteredPoints.addTo(map); }
  updateInfo(view);
}

document.getElementById('n-apple').textContent = DATA.devices.filter(d => d.vendor === 'apple').length;
document.getElementById('n-samsung').textContent = DATA.devices.filter(d => d.vendor === 'samsung').length;
document.getElementById('n-gatt').textContent = DATA.devices.filter(d => d.has_gatt).length;
buildPoints();
showView('raw');

// Debug handle — poke at the data/map from the browser console, e.g. __viz.DATA.
window.__viz = { map, DATA, highlightLayer, highlightDevice, showView, buildPoints,
                 setHide: (a, s) => { hideApple = a; hideSamsung = s; buildPoints(); updateInfo(currentView); } };
</script>
</body>
</html>
"""


def build_html(devices, zones):
    dev_list = []
    total_points = 0
    excluded = 0
    for d in devices.values():
        total_points += len(d["points"])
        if d.get("excluded"):
            excluded += 1
        dev_list.append(
            {
                "address": d["address"],
                "label": d["label"],
                "manuf": d["manuf"],
                "vendor": d.get("vendor"),
                "ibeacon": d.get("ibeacon"),
                "adv": d["adv"] if d.get("adv") else None,
                "gatt": d["gatt"] if d.get("gatt") else None,
                "has_gatt": bool(d.get("has_gatt")),
                "excluded": bool(d.get("excluded")),
                "points": [
                    {
                        "lat": p["lat"],
                        "lng": p["lng"],
                        "count": p["count"],
                        "best_rssi": p["best_rssi"],
                        "in_zone": bool(p.get("in_zone")),
                    }
                    for p in d["points"]
                ],
            }
        )
    data = {
        "devices": dev_list,
        "zones": zones,
        "meta": {
            "devices": len(dev_list),
            "points": total_points,
            "excluded": excluded,
            "zones": len(zones),
            "apple": sum(1 for x in dev_list if x["vendor"] == "apple"),
            "samsung": sum(1 for x in dev_list if x["vendor"] == "samsung"),
        },
    }
    payload = json.dumps(data).replace("<", "\\u003c")  # never break out of <script>
    return HTML_TEMPLATE.replace("__DATA_JSON__", payload), data["meta"]


# --- web server --------------------------------------------------------------
class _Handler(SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def log_message(self, *_):  # keep the console quiet
        pass


def make_server(directory, preferred_port):
    handler = partial(_Handler, directory=directory)
    candidates = [preferred_port, 0] if preferred_port else [8765, 8766, 8080, 0]
    last = None
    for c in candidates:
        try:
            return ThreadingHTTPServer(("127.0.0.1", c), handler)
        except OSError as e:
            last = e
    die(f"could not bind a local port: {last}")


# --- main --------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(
        prog="visualize-phone-data",
        description="Pull device/GPS data + exclusion zones off a XenoMetaRadar "
        "phone and visualize them on OpenStreetMap.",
    )
    ap.add_argument(
        "-s",
        "--serial",
        help="adb device serial, or a friendly alias from device-aliases.json "
        "(e.g. P1). Auto-picks if only one device is attached.",
    )
    ap.add_argument("--package", default=DEFAULT_PACKAGE, help="app package id (default: %(default)s)")
    ap.add_argument("--port", type=int, default=0, help="local web-server port (default: auto)")
    ap.add_argument("--db", help="use a local app-database file instead of pulling from a phone")
    ap.add_argument("--prefs", help="use a local app-prefs.xml file instead of pulling from a phone")
    ap.add_argument("--btides", help="GATT source: a BTIDES log/archive (.jsonl/.btides). "
                    "Overrides the on-phone log even during a live pull (the phone's log rotates).")
    ap.add_argument("--out", help="also write the generated HTML to this path")
    ap.add_argument("--no-serve", action="store_true", help="build the HTML and exit (no server/browser)")
    ap.add_argument("--no-browser", action="store_true", help="serve but don't auto-open the browser")
    args = ap.parse_args()

    tmp = tempfile.mkdtemp(prefix="xmr-viz-")

    # 1. obtain the data files (from a phone, or from local files)
    if args.db:
        db_path = args.db
        prefs_path = args.prefs
        btides_path = args.btides
        if not os.path.exists(db_path):
            die(f"--db file not found: {db_path}")
    else:
        serial = resolve_serial(args.serial)
        db_path, prefs_path, btides_path = pull_from_phone(serial, args.package, tmp)
        if args.btides:  # a pulled archive overrides the on-phone log (which rotates/clears)
            print(f"[*] using BTIDES archive for GATT: {args.btides}")
            btides_path = args.btides

    # 2. read + compute
    repo_dir = os.path.dirname(os.path.abspath(__file__))
    zones = parse_exclusion_zones(prefs_path)
    devices = load_device_points(db_path)
    mark_excluded(devices, zones)
    attrs = load_device_attrs(db_path)

    # Vendor classification (same rules as the phone's Hide/Skip Apple/Samsung).
    registry = load_vendor_registry(repo_dir)
    clues = load_clues_companies(repo_dir)
    classify_vendors(devices, attrs, registry, clues)

    # GATT/SDP hierarchy from the BTIDES log, UUIDs named via the app's SIG tables + CLUES.
    sig_svc, sig_char = load_sig_name_tables(repo_dir)
    clues_full = load_clues_full(repo_dir)
    attach_gatt(devices, attrs, load_gatt(btides_path, sig_svc, sig_char, clues_full),
                sig_svc, clues_full)

    # Advertisement (EIR/AD) parsing from the stored raw advert bytes (like the phone).
    attach_adv(devices, attrs, sig_svc, clues_full, load_company_ids(repo_dir))

    html, meta = build_html(devices, zones)
    print(
        f"[*] {meta['devices']} devices with GPS, {meta['points']} unique points, "
        f"{meta['zones']} exclusion zone(s); "
        f"{meta['excluded']} excluded by zones, {meta['devices'] - meta['excluded']} remain; "
        f"vendor: {meta['apple']} Apple, {meta['samsung']} Samsung."
    )
    if meta["devices"] == 0:
        print("[!] no devices have GPS coordinates — the map will be empty.")

    # 3. write index.html into the served dir
    index_path = os.path.join(tmp, "index.html")
    with open(index_path, "w", encoding="utf-8") as fh:
        fh.write(html)
    if args.out:
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(html)
        print(f"[*] wrote HTML to {args.out}")

    if args.no_serve:
        print(f"[*] --no-serve: HTML is at {index_path}")
        return

    # 4. serve + open browser
    httpd = make_server(tmp, args.port)
    url = f"http://127.0.0.1:{httpd.server_address[1]}/index.html"
    print(f"[*] serving at {url}   (Ctrl-C to stop)")
    if not args.no_browser:
        threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[*] stopped.")
    finally:
        httpd.server_close()


if __name__ == "__main__":
    main()
