def die(msg):
    print(f"visualize-phone-data: error: {msg}", file=sys.stderr)
    sys.exit(1)


# --- adb / device handling ---------------------------------------------------
def adb_devices():
    """Return list of (serial, model) for attached devices in `device` state."""
    try:
        out = subprocess.run(
            ["adb", "devices", "-l"], capture_output=True, text=True, check=True
        ).stdout
    except FileNotFoundError:
        die("`adb` not found on PATH. Install platform-tools or add adb to PATH.")
    except subprocess.CalledProcessError as e:
        die(f"`adb devices` failed: {e.stderr or e}")
    devices = []
    for line in out.splitlines()[1:]:
        line = line.strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "device":
            model = next(
                (p.split(":", 1)[1] for p in parts if p.startswith("model:")), "?"
            )
            devices.append((parts[0], model))
    return devices


def load_aliases():
    """Read friendly device-name -> serial mappings from `device-aliases.json`
    next to this script (e.g. {"P1": "1234ABCD"}). Returns {} if absent."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "device-aliases.json")
    if not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
        return {str(k): str(v) for k, v in raw.items()}
    except (json.JSONDecodeError, OSError, AttributeError) as e:
        print(f"[!] could not read {path}: {e} — ignoring aliases.")
        return {}


def resolve_serial(requested):
    aliases = load_aliases()
    if requested:
        # Translate a friendly alias (case-insensitive) like "P1" to its serial.
        for name, serial in aliases.items():
            if name.lower() == requested.strip().lower():
                print(f"[*] device alias {requested!r} -> {serial} (as {name})")
                return serial
        return requested  # not an alias — assume it's a literal serial
    devs = adb_devices()
    if not devs:
        die("no devices in `device` state. Plug in / authorize a phone, or use --db/--prefs.")
    if len(devs) == 1:
        print(f"[*] using the only attached device: {devs[0][0]} ({devs[0][1]})")
        return devs[0][0]
    rev = {serial: name for name, serial in aliases.items()}
    listing = "\n".join(
        f"    {s}  ({m})" + (f"   [alias: {rev[s]}]" if s in rev else "") for s, m in devs
    )
    hint = next(iter(aliases), devs[0][0])  # suggest an alias if one is defined
    die(
        "multiple devices attached — pass -s/--serial to choose one:\n"
        + listing
        + f"\n  e.g.  ./visualize-phone-data -s {hint}"
    )


def pull_appfile(serial, package, relpath, dest, required):
    """`adb exec-out run-as <pkg> cat <relpath>` -> dest (binary-safe). Returns
    True on success. If `required` and it fails, exits with a helpful message."""
    with open(dest, "wb") as fh:
        p = subprocess.run(
            ["adb", "-s", serial, "exec-out", "run-as", package, "cat", relpath],
            stdout=fh,
            stderr=subprocess.PIPE,
        )
    err = (p.stderr or b"").decode("utf-8", "replace").strip()
    ok = p.returncode == 0 and os.path.getsize(dest) > 0
    if not ok:
        try:
            os.remove(dest)
        except OSError:
            pass
        if not required:
            return False
        hint = ""
        if "not debuggable" in err or "unknown" in err or "run-as:" in err:
            hint = (
                f"\n  `run-as {package}` was refused. The app must be a *debuggable* "
                "build installed under that exact package id.\n"
                "  Check `adb -s %s shell pm list packages | grep darkmentor` and pass "
                "--package if it differs." % serial
            )
        die(f"could not read {relpath} from {package} on {serial}: {err or 'empty output'}{hint}")
    return True


def pull_from_phone(serial, package, workdir):
    """Pull the DB (+ -wal/-shm) and prefs into workdir. Returns (db, prefs)."""
    print(f"[*] pulling data from {serial} ({package}) — read-only ...")
    db_path = os.path.join(workdir, "app-database")
    pull_appfile(serial, package, DB_REL, db_path, required=True)
    # The Room DB runs in WAL mode; grab the sidecar files too so committed-but-
    # not-yet-checkpointed rows are visible when we open the DB. Best-effort.
    for suffix in ("-wal", "-shm"):
        pull_appfile(
            serial, package, DB_REL + suffix, db_path + suffix, required=False
        )
    prefs_path = os.path.join(workdir, "app-prefs.xml")
    if not pull_appfile(serial, package, PREFS_REL, prefs_path, required=False):
        print("[!] no app-prefs.xml found — assuming no exclusion zones are set.")
        prefs_path = None
    btides_path = os.path.join(workdir, "btides_log.jsonl")
    if not pull_appfile(serial, package, BTIDES_REL, btides_path, required=False):
        print("[!] no BTIDES log found — GATT/SDP hierarchy will be unavailable.")
        btides_path = None
    return db_path, prefs_path, btides_path


# --- parsing -----------------------------------------------------------------
def parse_exclusion_zones(prefs_path):
    """Read the `key_exclusion_zones` JSON array out of the prefs XML."""
    if not prefs_path or not os.path.exists(prefs_path):
        return []
    try:
        root = ET.parse(prefs_path).getroot()
    except ET.ParseError as e:
        print(f"[!] could not parse {prefs_path}: {e} — assuming no zones.")
        return []
    for el in root.findall("string"):
        if el.get("name") == EXCLUSION_KEY:
            raw = (el.text or "").strip()  # ElementTree already decoded &quot;
            if not raw:
                return []
            try:
                zones = json.loads(raw)
            except json.JSONDecodeError as e:
                print(f"[!] exclusion-zones JSON is malformed: {e} — ignoring.")
                return []
            return [z for z in zones if z.get("type") in ("circle", "square")]
    return []


def load_device_points(db_path):
    """Return {address: {address, label, name, manuf, points:[{lat,lng,...}]}}.

    Points are deduped per-device by coordinate; `count` tallies how many
    detections collapsed into each point."""
    import sqlite3

    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            """
            SELECT dtl.device_address AS addr,
                   l.lat  AS lat,
                   l.lng  AS lng,
                   l.time AS time,
                   dtl.rssi AS rssi,
                   d.name AS name,
                   d.custom_name AS custom_name,
                   d.manufacturer_name AS manuf
            FROM device_to_location dtl
            JOIN location l ON l.time = dtl.location_time
            LEFT JOIN device d ON d.address = dtl.device_address
            """
        ).fetchall()
    finally:
        con.close()

    devices = {}
    for r in rows:
        if r["lat"] is None or r["lng"] is None:
            continue
        d = devices.get(r["addr"])
        if d is None:
            label = (r["custom_name"] or r["name"] or "").strip() or "(unnamed)"
            d = {
                "address": r["addr"],
                "label": label,
                "manuf": (r["manuf"] or "").strip(),
                "points": {},
            }
            devices[r["addr"]] = d
        key = (round(r["lat"], 7), round(r["lng"], 7))
        pt = d["points"].get(key)
        if pt is None:
            d["points"][key] = {
                "lat": r["lat"],
                "lng": r["lng"],
                "count": 1,
                "best_rssi": r["rssi"],
            }
        else:
            pt["count"] += 1
            if r["rssi"] is not None and (
                pt["best_rssi"] is None or r["rssi"] > pt["best_rssi"]
            ):
                pt["best_rssi"] = r["rssi"]
    # flatten points dict -> list
    for d in devices.values():
        d["points"] = list(d["points"].values())
    return devices


# --- exclusion geometry (mirrors ExclusionZone.kt) ---------------------------
def haversine_m(lat1, lng1, lat2, lng2):
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dl = math.radians(lng2 - lng1)
    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * EARTH_R * math.asin(min(1.0, math.sqrt(a)))


def zone_contains(zone, lat, lng):
    clat, clng = zone["centerLat"], zone["centerLng"]
    if zone["type"] == "circle":
        return haversine_m(clat, clng, lat, lng) <= zone["radiusMeters"]
    if zone["type"] == "square":
        half = zone["halfSizeMeters"]
        d_lat = half / METERS_PER_DEG_LAT
        cos_lat = max(math.cos(math.radians(clat)), MIN_COS_LAT)
        d_lng = half / (METERS_PER_DEG_LAT * cos_lat)
        return abs(lat - clat) <= d_lat and abs(lng - clng) <= d_lng
    return False


def mark_excluded(devices, zones):
    """Per the spec: a device is excluded if ANY of its coordinates lies inside
    ANY exclusion zone. (Note: the app's *upload* filter is narrower — it only
    tests each device's single strongest-RSSI coordinate.) Each point is also
    flagged with `in_zone` so the UI can show which coordinate(s) triggered it."""
    for d in devices.values():
        any_in = False
        for p in d["points"]:
            p["in_zone"] = any(zone_contains(z, p["lat"], p["lng"]) for z in zones)
            any_in = any_in or p["in_zone"]
        d["excluded"] = any_in


# --- vendor classification (mirrors VendorIdentifier.kt) ---------------------
def load_vendor_registry(repo_dir):
    """Parse the Apple/Samsung OUI + UUID sets straight out of VendorRegistry.kt
    so they stay in lockstep with the app instead of being hand-copied."""
    reg = {k: set() for k in (
        "apple_ouis", "samsung_ouis", "apple_uuid16", "samsung_uuid16",
        "apple_clues", "samsung_clues")}
    path = os.path.join(repo_dir, VENDOR_REGISTRY_REL)
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        print("[!] VendorRegistry.kt not found — OUI/UUID vendor matching disabled "
              "(company-id + Galaxy-name still apply).")
        return reg
    # Each set is `val NAME: Set<...> = setOf( <hex ints | "uuid strings"> )`.
    for m in re.finditer(r'val\s+(\w+)\s*:\s*Set<[^>]+>\s*=\s*setOf\((.*?)\n\s*\)', text, re.S):
        name, body = m.group(1), m.group(2)
        ints = {int(h, 16) for h in re.findall(r'0x[0-9A-Fa-f]+', body)}
        strs = {s.lower() for s in re.findall(r'"([^"]*)"', body)}
        if name == "APPLE_OUIS":
            reg["apple_ouis"] = ints
        elif name == "SAMSUNG_OUIS":
            reg["samsung_ouis"] = ints
        elif name == "APPLE_SIG_UUID16S":
            reg["apple_uuid16"] = ints
        elif name == "SAMSUNG_SIG_UUID16S":
            reg["samsung_uuid16"] = ints
        elif name == "APPLE_CLUES_UUIDS":
            reg["apple_clues"] = strs
        elif name == "SAMSUNG_CLUES_UUIDS":
            reg["samsung_clues"] = strs
    return reg


def load_clues_companies(repo_dir):
    """normalized-UUID -> lowercased company, from the bundled CLUES_data.json."""
    out = {}
    path = os.path.join(repo_dir, CLUES_ASSET_REL)
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return out
    for e in data:
        u = e.get("UUID")
        if u:
            out[u.lower().strip()] = (e.get("company") or "").lower()
    return out


def _decode_rde(rde):
    if not rde:
        return None
    s = rde + "=" * (-len(rde) % 4)  # tolerate missing padding
    try:
        return base64.b64decode(s)
    except (binascii.Error, ValueError):
        return None


def _parse_adv_frames(raw):
    """`[len][type][data...]` EIR/AD frames; stop on any malformed frame."""
    out = []
    i, n = 0, len(raw)
    while i < n:
        length = raw[i]
        if length == 0 or i + 1 + length > n:
            break
        out.append((raw[i + 1], raw[i + 2:i + 1 + length]))  # (type, data)
        i += 1 + length
    return out


def _is_ibeacon(d):
    return len(d) >= 4 and d[0] == 0x4C and d[1] == 0x00 and d[2] == 0x02 and d[3] == 0x15


def _parse_ibeacon(frames):
    """Extract iBeacon UUID/major/minor from the advertisement, or None.

    Mirrors Blue2thprinting's scapy iBeacon layer (scapy/contrib/ibeacon.py): an Apple
    (company id 0x004C) MSD frame is a sequence of submessages `[subtype][len][payload]`;
    subtype 0x02 is iBeacon, whose payload is uuid(16, big-endian) + major(2) + minor(2)
    + tx_power(1). Walks every submessage so an iBeacon after another submessage is found."""
    for typ, data in frames:
        if typ != TYPE_MSD or len(data) < 2:
            continue
        if ((data[0] & 0xFF) | ((data[1] & 0xFF) << 8)) != APPLE_COMPANY_ID:
            continue
        pos = 2
        while pos + 2 <= len(data):
            subtype = data[pos] & 0xFF
            sublen = data[pos + 1] & 0xFF
            payload = data[pos + 2:pos + 2 + sublen]
            if subtype == APPLE_SUBTYPE_IBEACON and len(payload) >= 21:
                tx = payload[20] - 256 if payload[20] >= 128 else payload[20]
                return {
                    "uuid": str(uuidlib.UUID(bytes=bytes(payload[0:16]))),  # big-endian
                    "major": (payload[16] << 8) | payload[17],
                    "minor": (payload[18] << 8) | payload[19],
                    "tx_power": tx,
                }
            pos += 2 + sublen
    return None


def _read_uuids(data, size):
    out, p = [], 0
    while p + size <= len(data):
        v = 0
        for k in range(size):
            v |= (data[p + k] & 0xFF) << (k * 8)
        out.append(v)
        p += size
    return out


def _bytes_to_uuid128(data, off):
    be = bytes(data[off + 15 - k] for k in range(16))  # BLE wire is little-endian
    return str(uuidlib.UUID(bytes=be)).lower()


def _read_uuid128s(data):
    out, p = [], 0
    while p + 16 <= len(data):
        out.append(_bytes_to_uuid128(data, p))
        p += 16
    return out


def _le16(d, o):
    return (d[o] & 0xFF) | ((d[o + 1] & 0xFF) << 8)


def _le32(d, o):
    return ((d[o] & 0xFF) | ((d[o + 1] & 0xFF) << 8)
            | ((d[o + 2] & 0xFF) << 16) | ((d[o + 3] & 0xFF) << 24))


def _extract_adv_uuids(frames):
    out = []
    for typ, data in frames:
        t = typ & 0xFF
        if t in (0x02, 0x03, 0x14):
            out += ["%04x" % (v & 0xFFFF) for v in _read_uuids(data, 2)]
        elif t in (0x04, 0x05, 0x1F):
            out += ["%08x" % (v & 0xFFFFFFFF) for v in _read_uuids(data, 4)]
        elif t in (0x06, 0x07, 0x15):
            out += _read_uuid128s(data)
        elif t == 0x16 and len(data) >= 2:
            out.append("%04x" % (_le16(data, 0) & 0xFFFF))
        elif t == 0x20 and len(data) >= 4:
            out.append("%08x" % (_le32(data, 0) & 0xFFFFFFFF))
        elif t == 0x21 and len(data) >= 16:
            out.append(_bytes_to_uuid128(data, 0))
    return out


def _parse_local_name(frames):
    data = None
    for typ, d in frames:
        if (typ & 0xFF) == AD_TYPE_COMPLETE_LOCAL_NAME:
            data = d
            break
    if data is None:
        for typ, d in frames:
            if (typ & 0xFF) == AD_TYPE_SHORTENED_LOCAL_NAME:
                data = d
                break
    if data is None:
        return None
    try:
        s = data.decode("utf-8").strip()
    except UnicodeDecodeError:
        return None
    return s or None


def _short_uuid(u):
    s = u.lower()
    if len(s) == 4:
        try:
            return int(s, 16)
        except ValueError:
            return None
    if len(s) == 36 and s.startswith("0000") and s.endswith(SIG_BASE_SUFFIX):
        try:
            return int(s[4:8], 16)
        except ValueError:
            return None
    return None


def _parse_oui(address):
    parts = address.split(":")
    if len(parts) < 3:
        return -1
    try:
        return (int(parts[0], 16) << 16) | (int(parts[1], 16) << 8) | int(parts[2], 16)
    except ValueError:
        return -1


def _identify(company_id, oui, uuids, msd_ids, local_name, reg, clues):
    # 1. resolved manufacturer company id
    if company_id == APPLE_COMPANY_ID:
        return "apple"
    if company_id == SAMSUNG_COMPANY_ID:
        return "samsung"
    # 2. any (non-iBeacon) MSD frame company id
    for cid in msd_ids:
        if cid == APPLE_COMPANY_ID:
            return "apple"
        if cid == SAMSUNG_COMPANY_ID:
            return "samsung"
    # 3. public-address OUI
    if oui is not None:
        if oui in reg["apple_ouis"]:
            return "apple"
        if oui in reg["samsung_ouis"]:
            return "samsung"
    # 4. advertised / discovered UUIDs (SIG member, CLUES set, then CLUES company)
    for raw in uuids:
        short = _short_uuid(raw)
        if short is not None:
            if short in reg["apple_uuid16"]:
                return "apple"
            if short in reg["samsung_uuid16"]:
                return "samsung"
        lo = raw.lower()
        if lo in reg["apple_clues"]:
            return "apple"
        if lo in reg["samsung_clues"]:
            return "samsung"
        company = clues.get(lo.strip(), "")
        if company.startswith("apple"):
            return "apple"
        if "samsung" in company:
            return "samsung"
    # 5. Samsung "Galaxy" advertised local name (Samsung-only signal, checked last)
    if local_name and local_name.strip().lower().startswith(SAMSUNG_NAME_PREFIX):
        return "samsung"
    return None


def classify_vendor(attr, reg, clues):
    raw = _decode_rde(attr.get("row_data_encoded"))
    frames = _parse_adv_frames(raw) if raw else []

    adv_uuids = list(attr.get("service_uuids_list") or [])
    adv_uuids += _extract_adv_uuids(frames)

    # iBeacon carve-out: an Apple company id that only ever appears in iBeacon-shaped
    # MSD frames (Tesla/Estimote/etc. also broadcast iBeacons) is not "Apple".
    apple_non_ibeacon = any(
        typ == TYPE_MSD and len(data) >= 2 and not _is_ibeacon(data)
        and ((data[0] & 0xFF) | ((data[1] & 0xFF) << 8)) == APPLE_COMPANY_ID
        for typ, data in frames
    )
    mid = attr.get("manufacturer_id")
    company_id = None if (mid == APPLE_COMPANY_ID and not apple_non_ibeacon) else mid

    msd_ids = [
        (data[0] & 0xFF) | ((data[1] & 0xFF) << 8)
        for typ, data in frames
        if typ == TYPE_MSD and len(data) >= 2 and not _is_ibeacon(data)
    ]
    oui = _parse_oui(attr["address"]) if attr.get("system_address_type") == ADDR_TYPE_PUBLIC else None
    return _identify(company_id, oui, adv_uuids, msd_ids, attr.get("name"), reg, clues)


def load_device_attrs(db_path):
    """Per-device fields the vendor classifier needs (keyed by MAC address)."""
    import sqlite3

    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            "SELECT address, name, manufacturer_id, system_address_type, "
            "service_uuids, row_data_encoded FROM device"
        ).fetchall()
    finally:
        con.close()
    out = {}
    for r in rows:
        su = r["service_uuids"]
        su_list = [] if not su or not su.strip() else su.split(",")  # Converters.toStringList
        out[r["address"]] = {
            "address": r["address"],
            "name": r["name"],
            "manufacturer_id": r["manufacturer_id"],
            "system_address_type": r["system_address_type"],
            "service_uuids_list": su_list,
            "row_data_encoded": r["row_data_encoded"],
        }
    return out


def classify_vendors(devices, attrs, reg, clues):
    for addr, d in devices.items():
        a = attrs.get(addr)
        if not a:
            d["vendor"] = None
            d["ibeacon"] = None
            continue
        d["vendor"] = classify_vendor(a, reg, clues)
        raw = _decode_rde(a.get("row_data_encoded"))
        frames = _parse_adv_frames(raw) if raw else []
        d["ibeacon"] = _parse_ibeacon(frames)
        # A device carrying Apple's company id (0x004C) but NOT classified as a genuine
        # Apple device is just using the iBeacon advertising format, which is multi-vendor
        # (Tesla, Govee, Estimote, ...). Relabel it "iBeacon" instead of "Apple, Inc." so it
        # reads honestly — and so it's clear why "Hide Apple" (correctly) doesn't hide it.
        carries_apple_id = (a.get("manufacturer_id") == APPLE_COMPANY_ID
                            or d.get("manuf", "").lower().startswith("apple"))
        if carries_apple_id and d["vendor"] != "apple":
            d["manuf"] = "iBeacon"


# --- GATT / SDP hierarchy (from the phone's BTIDES log) ----------------------
def _parse_sig_map(path):
    """Pull `"XXXX" to "Name"` pairs out of one of the app's hardcoded SIG tables."""
    out = {}
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return out
    for m in re.finditer(r'"([0-9A-Fa-f]{4})"\s*to\s*"((?:[^"\\]|\\.)*)"', text):
        out[m.group(1).upper()] = m.group(2).encode().decode("unicode_escape")
    return out


def load_sig_name_tables(repo_dir):
    return (_parse_sig_map(os.path.join(repo_dir, SIG_SERVICE_KT)),   # GATT services
            _parse_sig_map(os.path.join(repo_dir, SIG_CHAR_KT)))      # GATT characteristics


def load_clues_full(repo_dir):
    """uuid(lower) -> {company, name, purpose} from CLUES_data.json (for UUID naming)."""
    out = {}
    try:
        data = json.load(open(os.path.join(repo_dir, CLUES_ASSET_REL), encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return out
    for e in data:
        u = e.get("UUID")
        if u:
            out[u.lower().strip()] = {
                "company": e.get("company"),
                "name": e.get("UUID_name"),
                "purpose": e.get("UUID_purpose"),
            }
    return out


def _uuid16_hex(u):
    """The 4-hex SIG short form of a UUID ("2A00"/"0000180a-...-base"), else None."""
    s = _short_uuid(u)
    return ("%04X" % s) if s is not None else None


def resolve_uuid_name(uuid, sig_table, clues_full):
    """Name precedence mirrors the app: SIG assigned-numbers, then CLUES, then None.
    Returns (name, company)."""
    h = _uuid16_hex(uuid)
    name = sig_table.get(h) if h else None
    info = clues_full.get(uuid.lower().strip())
    if not name and info:
        name = info.get("name")
    company = info.get("company") if info else None
    return name, company


def _printable_text(b):
    """UTF-8 decode iff the bytes look like text (the app's fallback for char values)."""
    if not b:
        return None
    try:
        s = b.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if any(ord(c) < 0x20 and c not in "\t\r\n" for c in s):
        return None
    s = s.strip()
    return s or None


def _props_list(p):
    return [label for bit, label in GATT_PROPS if p & bit]


def _decode_char_value(cv):
    """(text, '0x..HEX') for a characteristic's most recent ATT_READ_RSP value, or (None, None)."""
    if not isinstance(cv, dict):
        return None, None
    io = cv.get("io_array")
    if not isinstance(io, list):
        return None, None
    hexstr = None
    for e in io:
        if isinstance(e, dict) and "READ" in (e.get("io_type_str") or "").upper():
            v = e.get("value_hex_str")
            if v:
                hexstr = v  # keep the last READ response
    if not hexstr:
        return None, None
    try:
        b = bytes.fromhex(hexstr)
    except ValueError:
        b = None
    return _printable_text(b), "0x" + hexstr.upper()


def _hkey(k):
    return k if isinstance(k, int) else (1 << 62)  # sort handles asc; Nones last


def _iter_btides_records(path):
    """Yield BTIDES device records from either the live JSONL log (one object per line) or a
    pretty-printed `.btides` archive (a single JSON array of the same objects)."""
    try:
        text = open(path, encoding="utf-8", errors="ignore").read()
    except OSError:
        return
    if text.lstrip().startswith("["):
        try:
            records = json.loads(text)
        except json.JSONDecodeError:
            records = []
        for rec in records:
            if isinstance(rec, dict):
                yield rec
    else:
        for line in text.splitlines():
            line = line.strip()
            if line:
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue


def load_gatt(btides_path, sig_svc, sig_char, clues_full):
    """Parse the BTIDES log into {BDADDR: [service, ...]} with UUIDs named.

    A device is enumerated across MANY `GATTArray` records (a structure-only first pass,
    then later passes that carry the read values), so this MERGES all records per device:
    services keyed by begin-handle, characteristics by value-handle, taking the latest read
    value, OR-ing properties, and unioning descriptors. Mirrors how the app's BTIDES cache
    accumulates a device's GATT before DeviceDetailsViewModel renders it."""
    raw = {}  # addr -> {svc_handle: {"uuid", "chars": {char_handle: {...}}}}
    if not btides_path or not os.path.exists(btides_path):
        return {}
    for rec in _iter_btides_records(btides_path):
        ga = rec.get("GATTArray")
        if ga and (rec.get("bdaddr")):
            dev = raw.setdefault(rec["bdaddr"].upper(), {})
            for s in ga:
                svc = dev.setdefault(s.get("begin_handle"),
                                     {"uuid": s.get("UUID", ""), "chars": {}})
                for c in s.get("characteristics", []):
                    ch = svc["chars"].setdefault(
                        c.get("value_handle"),
                        {"uuid": c.get("value_uuid", ""), "props": 0, "cv": None, "descs": {}})
                    ch["props"] |= c.get("properties", 0)
                    if c.get("char_value"):
                        ch["cv"] = c["char_value"]  # a later read pass wins
                    for de in c.get("descriptors", []):
                        ch["descs"].setdefault(de.get("handle"), de)

    out = {}
    for addr, dev in raw.items():
        services = []
        for sk in sorted(dev, key=_hkey):
            svc = dev[sk]
            s_name, s_company = resolve_uuid_name(svc["uuid"], sig_svc, clues_full)
            chars = []
            for ck in sorted(svc["chars"], key=_hkey):
                ch = svc["chars"][ck]
                c_name, c_company = resolve_uuid_name(ch["uuid"], sig_char, clues_full)
                text, hex_str = _decode_char_value(ch["cv"])
                descs = []
                for dk in sorted(ch["descs"], key=_hkey):
                    de = ch["descs"][dk]
                    ud = de.get("user_description_hex_str")
                    descs.append({
                        "uuid": de.get("UUID", ""),
                        "type": de.get("type_str") or "",
                        "user_desc": _printable_text(bytes.fromhex(ud)) if ud else None,
                    })
                chars.append({
                    "uuid": ch["uuid"], "name": c_name, "company": c_company,
                    "props": _props_list(ch["props"]),
                    "value": text, "hex": hex_str, "descriptors": descs,
                })
            services.append({"uuid": svc["uuid"], "name": s_name,
                             "company": s_company, "chars": chars})
        out[addr] = services
    return out


def attach_gatt(devices, attrs, gatt_by_addr, sig_svc, clues_full):
    """Give each device its GATT services (enumerated) plus any advertised service UUIDs
    not already enumerated (shown as bare service rows, like the phone's merge)."""
    for addr, d in devices.items():
        enumerated = gatt_by_addr.get(addr, [])
        d["has_gatt"] = bool(enumerated)  # actually connected + read a GATT table
        services = [dict(s) for s in enumerated]
        present = {(_uuid16_hex(s["uuid"]) or s["uuid"].lower()) for s in services}
        for u in (attrs.get(addr, {}).get("service_uuids_list") or []):
            k = _uuid16_hex(u) or u.lower()
            if k and k not in present:
                name, company = resolve_uuid_name(u, sig_svc, clues_full)
                services.append({"uuid": u, "name": name, "company": company,
                                 "chars": [], "advertised": True})
                present.add(k)
        d["gatt"] = services


# --- advertisement (EIR/AD) parsing ------------------------------------------
def load_company_ids(repo_dir):
    """16-bit company id -> name, parsed from the app's BluetoothSIG.kt table."""
    out = {}
    try:
        text = open(os.path.join(repo_dir, BLUETOOTH_SIG_KT), encoding="utf-8").read()
    except OSError:
        return out
    for m in re.finditer(r'0x([0-9A-Fa-f]+)\s*to\s*"((?:[^"\\]|\\.)*)"', text):
        out[int(m.group(1), 16) & 0xFFFF] = m.group(2).encode().decode("unicode_escape")
    return out


def _hexstr(b):
    return ("0x" + b.hex().upper()) if b else ""


def _named_uuid(u, sig_svc, clues_full):
    name, _ = resolve_uuid_name(u, sig_svc, clues_full)
    return {"uuid": u, "name": name}


def _decode_uri(data):
    if not data:
        return ""
    prefix = URI_SCHEMES.get(data[0], "[scheme 0x%02X]" % data[0] if data[0] not in URI_SCHEMES else "")
    return prefix + (_printable_text(data[1:]) or _hexstr(data[1:]))


def _parse_msd(data, company_ids):
    """Manufacturer-Specific Data: company name + raw hex, and Apple Continuity/iBeacon decode."""
    if len(data) < 2:
        return {"hex": _hexstr(data)}
    cid = (data[0] & 0xFF) | ((data[1] & 0xFF) << 8)
    rows = [["Company", "%s (0x%04X)" % (company_ids.get(cid, "Unknown"), cid)]]
    if cid == APPLE_COMPANY_ID:
        subs, pos = [], 2
        while pos + 2 <= len(data):
            st, sl = data[pos], data[pos + 1]
            subs.append(APPLE_MSD_SUBTYPES.get(st, "Subtype 0x%02X" % st))
            pos += 2 + sl
        if subs:
            rows.append(["Apple submessages", ", ".join(subs)])
        ib = _parse_ibeacon([(TYPE_MSD, data)])
        if ib:
            rows += [["iBeacon UUID", ib["uuid"]], ["Major", str(ib["major"])],
                     ["Minor", str(ib["minor"])], ["TX Power", "%d dBm" % ib["tx_power"]]]
    return {"rows": rows, "hex": _hexstr(data[2:])}


def parse_advertisement(rde, sig_svc, clues_full, company_ids):
    """Parse the raw advertisement bytes into labeled AD records, like the phone /
    Tell_Me_Everything.py. Each record is {name, ...} where the extra keys depend on type:
    `bits`/`hex` (Flags), `uuids` (UUID lists & service data), `text` (names/URI),
    `rows` (key/value pairs, incl. MSD company + Apple/iBeacon), `hex` (raw bytes)."""
    raw = _decode_rde(rde)
    if not raw:
        return []
    out = []
    for typ, data in _parse_adv_frames(raw):
        t = typ & 0xFF
        rec = {"name": AD_TYPE_NAMES.get(t, "AD Type 0x%02X" % t)}
        if t == 0x01:
            f = data[0] if data else 0
            rec["hex"] = "0x%02X" % f
            rec["bits"] = [label for bit, label in FLAG_BITS if f & bit]
        elif t in (0x02, 0x03, 0x14):
            rec["uuids"] = [_named_uuid("%04x" % v, sig_svc, clues_full) for v in _read_uuids(data, 2)]
        elif t in (0x04, 0x05, 0x1F):
            rec["uuids"] = [_named_uuid("%08x" % v, sig_svc, clues_full) for v in _read_uuids(data, 4)]
        elif t in (0x06, 0x07, 0x15):
            rec["uuids"] = [_named_uuid(u, sig_svc, clues_full) for u in _read_uuid128s(data)]
        elif t in (0x08, 0x09, 0x30):
            rec["text"] = _printable_text(data) or _hexstr(data)
        elif t == 0x0A and data:
            rec["rows"] = [["Power", "%d dBm" % (data[0] - 256 if data[0] >= 128 else data[0])]]
        elif t == 0x19 and len(data) >= 2:
            rec["rows"] = [["Value", "0x%04X" % _le16(data, 0)]]
        elif t == 0x16 and len(data) >= 2:
            rec["uuids"] = [_named_uuid("%04x" % _le16(data, 0), sig_svc, clues_full)]
            rec["hex"] = _hexstr(data[2:])
        elif t == 0x20 and len(data) >= 4:
            rec["uuids"] = [_named_uuid("%08x" % _le32(data, 0), sig_svc, clues_full)]
            rec["hex"] = _hexstr(data[4:])
        elif t == 0x21 and len(data) >= 16:
            rec["uuids"] = [_named_uuid(_bytes_to_uuid128(data, 0), sig_svc, clues_full)]
            rec["hex"] = _hexstr(data[16:])
        elif t == 0x24:
            rec["text"] = _decode_uri(data)
        elif t == 0xFF:
            rec.update(_parse_msd(data, company_ids))
        else:
            rec["hex"] = _hexstr(data)
        out.append(rec)
    return out


def attach_adv(devices, attrs, sig_svc, clues_full, company_ids):
    for addr, d in devices.items():
        d["adv"] = parse_advertisement(
            attrs.get(addr, {}).get("row_data_encoded"), sig_svc, clues_full, company_ids)


