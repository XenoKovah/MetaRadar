<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30 and below (`android:fullBackupContent`). Devices on API 31+
    use the rules in `data_extraction_rules.xml` instead and ignore this file. Keep both files
    in sync.

    We <exclude> the BTIDALPOOL OAuth prefs (Google access + refresh tokens) so they don't
    ride along into a user's Drive cloud backup. Everything else (other prefs, the scan
    database) backs up normally under the default include-all behaviour.

    See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="btidalpool-auth.xml"/>
</full-backup-content>
