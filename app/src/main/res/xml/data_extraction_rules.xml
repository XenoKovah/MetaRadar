<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+ (`android:dataExtractionRules`). The legacy
    `backup_rules.xml` is ignored on these devices, so any rule we want to apply on modern
    Android must be replicated here.

    `<cloud-backup>` controls Google Drive auto-backup; `<device-transfer>` controls direct
    phone-to-phone migration during new-device setup. We <exclude> the BTIDALPOOL OAuth prefs
    from both — Google access + refresh tokens shouldn't leave the device in either flow.

    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="btidalpool-auth.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="btidalpool-auth.xml"/>
    </device-transfer>
</data-extraction-rules>
